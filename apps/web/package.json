{
	"name": "@saveroo/web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --port 5173 --strictPort",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --passWithNoTests",
		"deploy:worker": "pnpm build && wrangler deploy"
	},
	"dependencies": {
		"@saveroo/shared": "workspace:*",
		"@supabase/ssr": "~0.12.7",
		"@supabase/supabase-js": "~2.118.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.8",
		"wrangler": "^4.153.0"
	}
}
