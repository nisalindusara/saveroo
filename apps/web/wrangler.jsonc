// Cloudflare Worker config for the Saveroo web app (SvelteKit, adapter-cloudflare).
// Calls to the API go through the `API` service binding: Cloudflare blocks a Worker from
// fetching another Worker's workers.dev URL (error 1042). API_URL is the base URL for those calls.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saveroo-web",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "workers_dev": true,
  "preview_urls": true,
  "services": [{ "binding": "API", "service": "saveroo-api" }],
  "vars": {
    "API_URL": "https://saveroo-api.paranawithananisal19.workers.dev",
    // Staging Supabase. The publishable key is public by design (Row Level Security limits it).
    "SUPABASE_URL": "https://hhhzwfdmrfdmmmmftzoo.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_AdHCyHv98XYTu8g87NaTaQ_mr0Q3TGJ",
  },
}
