# Local settings for `pnpm dev` (web app). Copy to apps/web/.env.
# Where the API runs locally (`pnpm dev` starts it on port 8787).
API_URL=http://localhost:8787
# Supabase project used for signing in: Project Settings > API Keys (the publishable key, sb_publishable_...).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
