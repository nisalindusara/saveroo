// Cloudflare Worker config for the Saveroo API.
// Secrets (SUPABASE_SECRET_KEY) are set with `wrangler secret put`, never here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saveroo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://hhhzwfdmrfdmmmmftzoo.supabase.co",
  },
}
