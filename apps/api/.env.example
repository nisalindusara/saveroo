# Local settings for `pnpm dev` (API Worker). Copy to apps/api/.env and fill in.
# Values come from the Supabase dev project: Project Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (starts with sb_secret_) or the legacy service_role key. Never share or commit it.
SUPABASE_SECRET_KEY=
